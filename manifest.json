{
  "manifest_version": 3,
  "name": "Calmer Card",
  "version": "0.1.1",
  "description": "A calmer Swapcard: one calendar, one inbox, profiles that open in place.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.swapcard.com/*"
      ],
      "js": [
        "src/core.js",
        "src/data.js",
        "src/ui.js",
        "src/nav.js",
        "src/calendar.js",
        "src/drawer.js",
        "src/inbox.js",
        "src/booking.js",
        "src/feedback.js",
        "src/boot.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
