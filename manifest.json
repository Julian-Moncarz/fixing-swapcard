{
  "manifest_version": 3,
  "name": "Calmer Card",
  "version": "0.1.0",
  "description": "A calmer Swapcard: one calendar, one inbox, profiles that open in place.",
  "host_permissions": ["https://app.swapcard.com/*"],
  "content_scripts": [
    {
      "matches": ["https://app.swapcard.com/*"],
      "js": [
        "src/core.js",
        "src/data.js",
        "src/ui.js",
        "src/calendar.js",
        "src/drawer.js",
        "src/inbox.js",
        "src/booking.js",
        "src/feedback.js",
        "src/boot.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
